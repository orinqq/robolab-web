{
  "name": "robolab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RoboLab: web (Vite + React) para docentes, alumnos y retos abiertos. El backend es el paquete @robolab/backend.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@blobatar/react": "2.7.0",
    "@convex-dev/auth": "0.0.96",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@robolab/backend": "git+https://github.com/cuevaio/hta-robolab-backend-orinqq.git#7ccf47fb48ed1c37b1ea4477c9dbaa7d7c8fe97c",
    "blobatar": "2.7.0",
    "convex": "1.47.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
